{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    "module": "ESNext",
    "strict": true,
    "target": "es5",
    "lib": ["esnext", "dom", "dom.iterable", "es6", "es2017"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["client/src/*"],
      "@shared/*": ["shared/src/*"]
    }
  },
  "include": [
    "client/src/**/*",
    "server/src/**/*",
    "shared/src/**/*",
    "shared/types/**/*"
  ],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts"]
}
