{
  "extends": "./tsconfig.base.json", // Убедись, что этот путь правильный относительно tsconfig.server.json
  "compilerOptions": {
    "target": "ES2022",
    "esModuleInterop": true,
    "module": "NodeNext", // Поддержка import.meta
    "moduleResolution": "NodeNext", // Требуется для совместимости с module NodeNext
    "rootDirs": ["server/src", "shared/src"], // Указываем конкретную корневую директорию для исходников сервера
    "outDir": "./dist/server",
    "baseUrl": ".", // Базовый URL для разрешения путей
    "paths": {
      // Переопределяем или дополняем пути из tsconfig.base.json, если необходимо,
      // но обычно наследованных путей должно быть достаточно.
      // "@/*": ["server/src/*"], // Можно добавить специфичный для сервера алиас
      "@shared/*": ["shared/src/*"] // Должно наследоваться из tsconfig.base.json
    },
    // Ensure TypeScript can resolve global type packages. The previous relative
    // path pointed outside of the repository and failed on some systems.
    "typeRoots": ["./server/src/types", "./node_modules/@types"]
  },
  "include": ["server/src/**/*", "shared/src/**/*"],
  "exclude": ["node_modules", "dist"]
}