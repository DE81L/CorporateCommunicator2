{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": ".",
    "outDir": "dist",
    "target": "es2020",
    "module": "ESNext",
    "lib": ["es2020"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "types": ["node"]
  },
  "include": [
    "src/**/*",
    "electron-shared/**/*",
    "types/**/*",
    "utils/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}