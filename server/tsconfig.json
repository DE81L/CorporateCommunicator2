{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "rootDir": "src",
    "outDir": "../dist/server",
    "baseUrl": "../",
    "paths": {
      "@shared/*": ["dist/shared/*"],
      "@shared/types/*": ["dist/shared/types/*"]
    },
    "tsBuildInfoFile": "../dist/server/tsconfig.tsbuildinfo",
    "composite": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../shared"
    }
  ]
}
