{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "src",
    "outDir": "../dist/server",
    "tsBuildInfoFile": "../dist/server/tsconfig.tsbuildinfo",
    "composite": true,
    "esModuleInterop": true,
    "skipLibCheck": true
