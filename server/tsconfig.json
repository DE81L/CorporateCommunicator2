{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "rootDir": ".",
    "outDir": "./dist/server",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["../shared/src/*"]
    },
    "typeRoots": ["./src/types", "../node_modules/@types"]
  },
  "include": [
    "src/**/*",
    "../shared/src/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
