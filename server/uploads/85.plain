--- File: C:\Users\DE81L\Downloads\CCNew\scripts\check-shared-imports.js ---
import fs from 'fs';
import path from 'path';
import glob from 'glob';

const alias = '@shared';
const sharedDir = path.resolve('shared/src');

const patterns = [
  'server/src/**/*.ts',
  'client/src/**/*.{ts,tsx}',
  'electron/src/**/*.ts',
];

for (let pat of patterns) {
  for (let file of glob.sync(pat)) {
    const src = fs.readFileSync(file, 'utf8');
    const re = /from\s+['"]@shared\/([^'"]+)['"]/g;
    let match;
    while (match = re.exec(src)) {
      const imp = match[1];
      const tsFile = path.join(sharedDir, imp + '.ts');
      const idxFile = path.join(sharedDir, imp, 'index.ts');
      if (!fs.existsSync(tsFile) && !fs.existsSync(idxFile)) {
        console.log(`⚠️  ${file} → missing @shared/${imp}`);
      }
    }
  }
}


--- File: C:\Users\DE81L\Downloads\CCNew\scripts\instrument.ts ---
import { Project } from 'ts-morph';
const project = new Project({ tsConfigFilePath: 'server/tsconfig.server.json' });

project.getSourceFiles('server/src/**/*.ts').forEach(sf => {
  if (sf.getFilePath().includes('node_modules')) return;
  const funcs = [...sf.getFunctions(), ...sf.getClasses().flatMap(c => c.getMethods())];
  funcs.forEach(fn => {
    if (fn.getDecorator('Trace')) return;
    fn.addDecorator({ name: 'Trace', arguments: [] });
  });
  if (!sf.getImportDeclaration(d => d.getModuleSpecifierValue() === '../util/trace')) {
    sf.addImportDeclaration({ namedImports: ['Trace'], moduleSpecifier: '../util/trace' });
  }
});
project.saveSync();


