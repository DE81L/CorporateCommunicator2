  const entryId = +req.params.id;
  const { rows } = await db!.query('SELECT * FROM wiki_entries WHERE id = $1', [entryId]);
  if (rows.length === 0) {
    return res.status(404).json({ error: 'Entry not found' });
  }
  res.json(rows[0]);
});

