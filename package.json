    "react-resizable-panels": "^3.0.1",
    "recharts": "^2.15.3",
    "rimraf": "^6.0.1",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.2.0",
    "tslog": "4.9.3",
    "tsx": "^4.19.4",
    "vaul": "^1.1.2",
    "wouter": "^3.7.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "latest",
