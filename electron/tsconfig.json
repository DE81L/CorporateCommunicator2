{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ES2022",
    "types": [
      "vite/client"
    ],
    "outDir": "dist",
    "skipLibCheck": true,
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "../shared/src/*"
      ],
      "@shared/types/*": [
        "../shared/types/*"
      ]
    }
  },
  "include": [
    "src",
    "../shared/src",
    "../shared/types"
  ]
}