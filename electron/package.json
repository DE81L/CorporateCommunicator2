{
  "name": "ccnew-electron",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "electron --no-sandbox -r tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "pack": "pnpm run build && electron-builder --win"
  },
  "dependencies": {
    "electron": "36.2.0"
  },
  "devDependencies": {
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.4",
    "electron-builder": "^24.6.4"
  },
  "build": {
    "appId": "com.corporate.communicator",
    "files": [
      "dist/**/*",
      "../client/dist/**/*"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": ["nsis"]
    }
  }
}

